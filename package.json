{
  "name": "fjord-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "reference/svelte"
  ],
  "scripts": {
    "format:check": "prettier --check package.json reference/svelte tests/types scripts/*.mjs .github/workflows/validate.yml",
    "format": "prettier --write package.json reference/svelte tests/types scripts/*.mjs .github/workflows/validate.yml",
    "check:reference": "bun run --cwd reference/svelte check",
    "build:reference": "bun run --cwd reference/svelte build",
    "build:storybook": "bun run --cwd reference/svelte build:storybook",
    "test:types": "node scripts/check-types.mjs",
    "test:storybook-types": "node scripts/check-storybook-types.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1"
  },
  "patchedDependencies": {
    "@storybook/react@10.6.3": "patches/@storybook%2Freact@10.6.3.patch"
  }
}
