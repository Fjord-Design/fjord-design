{
  "name": "@fjord/svelte",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/lib/index.ts",
      "svelte": "./src/lib/index.ts"
    },
    "./form-controls.css": "./src/lib/form-controls.css",
    "./choices.css": "./src/lib/choices.css",
    "./layout-components.css": "./src/lib/layout-components.css",
    "./overlay-components.css": "./src/lib/overlay-components.css",
    "./data-feedback.css": "./src/lib/data-feedback.css",
    "./type-components.css": "./src/lib/type-components.css"
  },
  "scripts": {
    "check": "node ../../scripts/check-reference.mjs",
    "build": "svelte-package --input src/lib --output ../../dist/svelte && node ../../scripts/package-reference.mjs && vite build",
    "dev": "vite --host 127.0.0.1",
    "storybook": "storybook dev --host 127.0.0.1 --port 6006 --disable-telemetry",
    "build:storybook": "storybook build --output-dir ../../dist/storybook --disable-telemetry"
  },
  "devDependencies": {
    "@storybook/react": "10.6.3",
    "@storybook/svelte-vite": "10.6.3",
    "@sveltejs/package": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "storybook": "10.6.3",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "peerDependencies": {
    "svelte": "^5.57.2"
  }
}
